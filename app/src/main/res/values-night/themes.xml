<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme overrides -->
    <style name="Theme.StockApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary brand color -->
                <item name="colorTertiary">@color/tertiary</item>
                <item name="colorTertiaryContainer">@color/tertiary_container</item>
                <item name="colorOnTertiary">@color/on_tertiary</item>
                <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

                <!-- Error color -->
                <item name="colorError">@color/error</item>
                <item name="colorErrorContainer">@color/error_container</item>
                <item name="colorOnError">@color/on_error</item>
                <item name="colorOnErrorContainer">@color/on_error_container</item>

                <!-- Surface colors -->
                <item name="colorSurface">#1C1B1F</item>
                <item name="colorOnSurface">#E6E1E5</item>
                <item name="colorSurfaceVariant">#49454F</item>
                <item name="colorOnSurfaceVariant">#CAC4D0</item>

                <!-- Outline colors -->
                <item name="colorOutline">#938F99</item>
                <item name="colorOutlineVariant">#49454F</item>

                <!-- Background color (deprecated, use colorSurface) -->
                <item name="colorSurfaceContainer">#1C1B1F</item>
                <item name="colorOnSurface">#E6E1E5</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Custom colors for dark mode -->
        <item name="profit">#66BB6A</item>
        <item name="profit_light">#1B5E20</item>
        <item name="loss">#EF5350</item>
        <item name="loss_light">#B71C1C</item>
        <item name="warning">#FFB74D</item>
        <item name="warning_light">#E65100</item>
        <item name="info">#64B5F6</item>
        <item name="info_light">#0D47A1</item>

        <item name="ipo_open">#66BB6A</item>
        <item name="ipo_upcoming">#64B5F6</item>
        <item name="ipo_allotment">#FFB74D</item>
        <item name="ipo_listed">#CE93D8</item>
        <item name="ipo_closed">#9E9E9E</item>

        <item name="impact_critical">#EF5350</item>
        <item name="impact_high">#FFB74D</item>
        <item name="impact_medium">#64B5F6</item>
        <item name="impact_low">#9E9E9E</item>

        <item name="sentiment_positive">#66BB6A</item>
        <item name="sentiment_negative">#EF5350</item>
        <item name="sentiment_neutral">#9E9E9E</item>

        <item name="risk_low">#66BB6A</item>
        <item name="risk_medium">#FFB74D</item>
        <item name="risk_high">#EF5350</item>

        <item name="custom_divider">#3D3D3D</item>
    </style>
</resources>