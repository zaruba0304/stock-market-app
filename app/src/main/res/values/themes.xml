<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.StockApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryVariant">@color/tertiary_variant</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <!-- Error color -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Outline colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Background color -->
        <item name="colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

                <!-- Custom colors for light mode -->
                <item name="profit">#2E7D32</item>
                <item name="profit_light">#C8E6C9</item>
                <item name="loss">#C62828</item>
                <item name="loss_light">#FFCDD2</item>
                <item name="warning">#EF6C00</item>
                <item name="warning_light">#FFF3E0</item>
                <item name="info">#1565C0</item>
                <item name="info_light">#E3F2FD</item>

                <item name="ipo_open">#2E7D32</item>
                <item name="ipo_upcoming">#1565C0</item>
                <item name="ipo_allotment">#EF6C00</item>
                <item name="ipo_listed">#7B1FA2</item>
                <item name="ipo_closed">#757575</item>

                <item name="impact_critical">#C62828</item>
                <item name="impact_high">#EF6C00</item>
                <item name="impact_medium">#1565C0</item>
                <item name="impact_low">#757575</item>

                <item name="sentiment_positive">#2E7D32</item>
                <item name="sentiment_negative">#C62828</item>
                <item name="sentiment_neutral">#757575</item>

                <item name="risk_low">#2E7D32</item>
                <item name="risk_medium">#EF6C00</item>
                <item name="risk_high">#C62828</item>

                <item name="divider">#E0E0E0</item>

                <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.StockApp.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.StockApp.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.StockApp.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.StockApp.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.StockApp.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.StockApp.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.StockApp.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.StockApp.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.StockApp.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.StockApp.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.StockApp.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.StockApp.LabelSmall</item>
    </style>

    <!-- Custom Text Appearances -->
    <style name="TextAppearance.StockApp.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.StockApp.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.StockApp.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.StockApp.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.StockApp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.StockApp.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.StockApp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.StockApp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.StockApp.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.StockApp.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.StockApp.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.StockApp.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.StockApp.Chip" parent="Widget.Material3.Chip.Entry">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.StockApp.Card" parent="Widget.Material3.Card.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.StockApp.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.StockApp.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.StockApp.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="Widget.StockApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.StockApp.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.StockApp.LabelSmall</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.StockApp.LabelSmall</item>
    </style>
</resources>